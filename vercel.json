{
  "routes": [
    {
      "src": "/(.*)\\.(jpg|jpeg|png|webp|svg|woff2)",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" },
      "continue": true
    },
    {
      "src": "/robots\\.txt",
      "dest": "/robots.txt",
      "headers": { "Content-Type": "text/plain; charset=utf-8" }
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/sitemap.xml",
      "headers": { "Content-Type": "application/xml; charset=utf-8" }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/projects-data/(.*)",
      "dest": "/projects-data/$1"
    },
    {
      "src": "/project-template.html",
      "dest": "/project-template.html"
    },
    {
      "src": "/(azabu-gardens|brillia-hongo|century-forest|ginza-plaza|harajuku-loft|kawana|minamiaoyama-house|nishiazabu-residence|park-mansion|proud-rokakoen|roppongi-hills|shibuya-towers)",
      "dest": "/$1/index.html"
    },
    {
      "src": "/(azabu-gardens|brillia-hongo|century-forest|ginza-plaza|harajuku-loft|kawana|minamiaoyama-house|nishiazabu-residence|park-mansion|proud-rokakoen|roppongi-hills|shibuya-towers)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}